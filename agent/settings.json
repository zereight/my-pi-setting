{
  "lastChangelogVersion": "0.78.0",
  "defaultProvider": "cursor",
  "defaultModel": "composer-2.5",
  "defaultThinkingLevel": "off",
  "packages": [
    "npm:pi-cursor-sdk",
    "npm:pi-dynamic-workflows"
